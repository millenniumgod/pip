# 이 파일을 .env로 복사한 뒤 Bunny Stream 라이브러리 ID를 넣으세요.
# 라이브러리 ID는 Bunny 대시보드 Stream > 라이브러리 > API 탭에서 확인합니다 (숫자).
# API 키와 토큰 인증 키는 여기(.env)에 넣지 말고, 아래 명령으로 별도 등록하세요 (README 참고):
#   firebase functions:secrets:set BUNNY_API_KEY
#   firebase functions:secrets:set BUNNY_TOKEN_KEY
BUNNY_LIBRARY_ID=

# 토스페이먼츠 (개인 수강 결제)
# 클라이언트 키는 공개용이라 .env에 넣고, 시크릿 키는 아래 명령으로 등록합니다.
#   firebase functions:secrets:set TOSS_SECRET_KEY
TOSS_CLIENT_KEY=test_ck_여기에_클라이언트_키

# 네이버·카카오 로그인 (선택)
# 개발자센터에서 앱을 만들고 Redirect URI 로 https://<사이트 주소>/auth/ 를 등록하세요.
#   firebase functions:secrets:set KAKAO_CLIENT_SECRET
#   firebase functions:secrets:set NAVER_CLIENT_SECRET
KAKAO_REST_KEY=
NAVER_CLIENT_ID=
